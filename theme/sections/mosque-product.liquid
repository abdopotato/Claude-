{{ 'mosque-design.css' | asset_url | stylesheet_tag }}
{{ 'mosque-update.css' | asset_url | stylesheet_tag }}
{%- liquid
  assign current = product.selected_or_first_available_variant
  assign arabic = ''
  assign rows_line = ''
  assign coverage = ''
  assign price_note = section.settings.price_note
  if product.tags contains 'musalla'
    assign arabic = 'مصلى صغير'
    assign rows_line = '≈ 5 prayer rows at 95cm'
    assign coverage = 'Approx. 4 × 6 m (24 m²)'
  elsif product.tags contains 'main-hall'
    assign arabic = 'القاعة الرئيسية'
    assign rows_line = '≈ 10 prayer rows at 95cm'
    assign coverage = 'Approx. 8 × 12 m (96 m²)'
  elsif product.tags contains 'jumuah'
    assign arabic = 'قاعة الجمعة'
    assign rows_line = '≈ 19 prayer rows at 95cm'
    assign coverage = 'Approx. 15 × 22 m (330 m²)'
    assign price_note = 'roll layout planned from your floor plan'
  endif
-%}
<div id="mcc-app">
<div class="mcc-wrap">
  <div class="mcc-crumbs"><a href="{{ routes.root_url }}">Home</a> / <a href="{{ routes.root_url }}#sizes">Hall sizes</a> / {{ product.title }}</div>
  <div class="mcc-pdp">
    <div class="mcc-gallery">
      <div class="mcc-gal-main">
        {%- if product.featured_media -%}
          {%- assign alt = product.featured_media.alt | default: product.title -%}
          {{ product.featured_media.preview_image | image_url: width: 1400 | image_tag: loading: 'eager', fetchpriority: 'high', widths: '600, 900, 1200, 1400', sizes: '(min-width: 900px) 600px, 100vw', alt: alt, id: 'mccMainImg' }}
        {%- else -%}
          {%- comment -%} No product photo yet: show the real carpet design in the chosen colourway (swapped by the script below). {%- endcomment -%}
          <img id="mccDesignImg" src="{{ 'mosque-design-green.jpg' | asset_img_url: '1200x' }}" srcset="{{ 'mosque-design-green.jpg' | asset_img_url: '600x' }} 600w, {{ 'mosque-design-green.jpg' | asset_img_url: '900x' }} 900w, {{ 'mosque-design-green.jpg' | asset_img_url: '1200x' }} 1200w" sizes="(min-width: 900px) 600px, 100vw" width="1200" height="1200" alt="Carpet design in Green: a row of arched prayer spaces with a floral border" fetchpriority="high">
        {%- endif -%}
        <div class="mcc-3d-stage" id="mcc3dStage" tabindex="0" hidden aria-label="3D carpet roll. Drag the roll to unroll it, drag elsewhere to turn it, scroll or pinch to zoom. Arrow keys also turn it."><p class="mcc-3d-msg" id="mcc3dMsg">Loading the 3D roll…</p></div>
      </div>
      <div class="mcc-3d-bar" id="mcc3dBar" hidden data-script="{{ 'mosque-roll-3d.js' | asset_url }}">
        <button type="button" class="mcc-btn-secondary" id="mcc3dOpen" aria-controls="mcc3dStage" aria-expanded="false">View the roll in 3D</button>
        <div class="mcc-3d-controls" id="mcc3dControls" hidden>
          <button type="button" class="mcc-btn-secondary" id="mcc3dRoll">Unroll</button>
          <input type="range" id="mcc3dFrac" min="0" max="1000" value="450" aria-label="How far the roll is unrolled">
          <button type="button" class="mcc-btn-ghost" id="mcc3dClose">Back to photo</button>
        </div>
        <p class="mcc-3d-note" id="mcc3dNote" hidden>Drag the roll to unroll it. Drag the floor to turn it. One roll is one prayer row, <span id="mcc3dWidth">95</span>cm wide.</p>
      </div>
      {%- if product.media.size > 1 -%}
        <div class="mcc-gal-thumbs" role="list">
          {%- for m in product.media limit: 5 -%}
            {%- assign alt = m.alt | default: product.title -%}
            <button type="button" class="mcc-thumb" role="listitem" aria-current="{% if forloop.first %}true{% else %}false{% endif %}" aria-label="Show image {{ forloop.index }}: {{ alt | escape }}" data-src="{{ m.preview_image | image_url: width: 1400 }}" data-alt="{{ alt | escape }}">
              {{ m.preview_image | image_url: width: 200 | image_tag: loading: 'lazy', alt: '' }}
            </button>
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>

    <div>
      {%- if arabic != blank -%}<div class="mcc-dims-ar" style="font-size:16px;">{{ arabic }}</div>{%- endif -%}
      <h1>{{ product.title }}</h1>
      {%- if rows_line != blank -%}<div class="mcc-sub"><span>{{ rows_line }}</span></div>{%- endif -%}
      <div class="mcc-p-price"><span id="mccPrice">{{ current.price | money_without_trailing_zeros }} {{ cart.currency.iso_code }}</span> <small>{{ price_note }}</small></div>

      {%- form 'product', product, id: 'mcc-product-form' -%}
        {%- if product.has_only_default_variant -%}
          <input type="hidden" name="id" value="{{ current.id }}">
        {%- else -%}
          <fieldset class="mcc-opt-group">
            <legend class="mcc-opt-label">Row spacing <span>Not sure? 95cm suits most mosques</span></legend>
            <div class="mcc-chips">
              {%- for v in product.variants -%}
                {%- assign hint = '' -%}
                {%- if v.title contains '90' -%}{%- assign hint = 'Tighter halls' -%}{%- elsif v.title contains '95' -%}{%- assign hint = 'Recommended' -%}{%- elsif v.title contains '100' -%}{%- assign hint = "Jumu'ah & Eid" -%}{%- endif -%}
                <label class="mcc-chip">
                  <input type="radio" name="id" value="{{ v.id }}" data-price="{{ v.price | money_without_trailing_zeros | append: ' ' | append: cart.currency.iso_code | escape }}" data-spacing="{{ v.title | remove: 'cm' | strip }}" {% if v.id == current.id %}checked{% endif %} {% unless v.available %}disabled{% endunless %}>
                  <b>{{ v.title }}</b><small>{{ hint }}</small>
                </label>
              {%- endfor -%}
            </div>
          </fieldset>
        {%- endif -%}

        <fieldset class="mcc-opt-group">
          <legend class="mcc-opt-label">Colourway <span id="mccCwName">Green</span></legend>
          <div class="mcc-dots-row">
            {%- comment -%} name : swatch colour : pattern file : pattern repeat width ÷ row depth {%- endcomment -%}
            {%- assign cws = 'Green:#256B51:green:0.3711,Red:#AC2931:red:0.3926,Dark blue:#5883AE:dark-blue:0.3711,Natural:#BAB1AC:natural:0.3711,Cream:#F2E4C7:cream:0.375' | split: ',' -%}
            {%- for cw in cws -%}
              {%- assign parts = cw | split: ':' -%}
              {%- assign pattern = 'mosque-roll-' | append: parts[2] | append: '.jpg' -%}
              <label class="mcc-cdot" style="background:{{ parts[1] }}" title="{{ parts[0] }}">
                <input type="radio" name="properties[Colourway]" value="{{ parts[0] }}" data-colour="{{ parts[1] }}" data-pattern="{{ pattern | asset_url }}" data-aspect="{{ parts[3] }}" data-design="{{ 'mosque-design-' | append: parts[2] | append: '.jpg' | asset_img_url: '1200x' }}" data-design-set="{% assign d = 'mosque-design-' | append: parts[2] | append: '.jpg' %}{{ d | asset_img_url: '600x' }} 600w, {{ d | asset_img_url: '900x' }} 900w, {{ d | asset_img_url: '1200x' }} 1200w" {% if forloop.first %}checked{% endif %} aria-label="{{ parts[0] }}">
              </label>
            {%- endfor -%}
          </div>
        </fieldset>

        <div class="mcc-buy">
          <button type="submit" name="add" class="mcc-btn-primary" {% unless current.available %}disabled{% endunless %}>{% if current.available %}Add to cart{% else %}Currently unavailable{% endif %}</button>
          <a href="/pages/contact?product={{ product.handle | url_encode }}" class="mcc-btn-secondary">Request a quote instead</a>
        </div>
        {%- if form.errors -%}<div class="mcc-form-error">{{ form.errors | default_errors }}</div>{%- endif -%}
      {%- endform -%}

      <ul class="mcc-assure">
        <li>Measured before we cut</li>
        <li>Invoiced in your mosque's name</li>
        <li>Fire-rated pile</li>
        <li>Lines squared to the qibla</li>
      </ul>

      <div class="mcc-acc">
        <details open><summary>About this carpet</summary><div class="mcc-body">{{ product.description }}</div></details>
        <details><summary>Specifications</summary><div class="mcc-body"><table class="mcc-spec">
          {%- if coverage != blank -%}<tr><td>Coverage</td><td>{{ coverage }}</td></tr>{%- endif -%}
          <tr><td>Roll widths</td><td>1.5–6 m, cut to your hall</td></tr>
          <tr><td>Row spacing</td><td>90, 95 or 100cm, woven in</td></tr>
          <tr><td>Pile</td><td>{{ section.settings.pile }}</td></tr>
          <tr><td>Fire rating</td><td>{{ section.settings.fire_rating }}</td></tr>
        </table></div></details>
        <details><summary>Delivery &amp; lead time</summary><div class="mcc-body"><p>{{ section.settings.delivery_text }}</p></div></details>
        <details><summary>Hall planning</summary><div class="mcc-body"><p>We plan the roll widths from your measurements so seams fall between prayer rows and the saff lines run square to the qibla wall, and send the layout with your order. <a href="/pages/hall-planning">How we plan your hall →</a></p></div></details>
        <details><summary>Payment for committees</summary><div class="mcc-body"><p>{{ section.settings.payment_text }}</p></div></details>
      </div>
    </div>
  </div>
</div>

<section class="mcc-section mcc-process">
  <div class="mcc-wrap">
    <div class="mcc-section-head" style="margin-bottom:28px;" data-reveal><h2>Other hall sizes</h2></div>
    <div class="mcc-grid-by-size">
      {%- assign shown = 0 -%}
      {%- for p in collections.all.products -%}
        {%- if p.id == product.id or shown >= 2 -%}{%- continue -%}{%- endif -%}
        {%- assign shown = shown | plus: 1 -%}
        <a class="mcc-size-card" href="{{ p.url }}" data-reveal><h3>{{ p.title }}</h3><div class="mcc-size-foot"><div class="mcc-price">from {{ p.price_min | money_without_trailing_zeros }} {{ cart.currency.iso_code }}</div><span class="mcc-card-link">View details</span></div></a>
      {%- endfor -%}
      <a class="mcc-size-card" href="/pages/contact" data-reveal><h3>Something else?</h3><p>L-shaped rooms, women's galleries, stairs. Send us the plan.</p><div class="mcc-size-foot"><div class="mcc-price">Quoted to measure</div><span class="mcc-card-link">Request a quote</span></div></a>
    </div>
  </div>
</section>
</div>

<script>
(function(){
  try{
    var form = document.getElementById('mcc-product-form');
    if(!form) return;
    var price = document.getElementById('mccPrice'), cwName = document.getElementById('mccCwName');
    var carpet = document.getElementById('mccArtCarpet'), lines = document.getElementById('mccArtLines'), cap = document.getElementById('mccArtCap');
    var coverage = {{ coverage | json }};
    function sel(name){ return form.querySelector('input[name="' + name + '"]:checked'); }
    function update(){
      var v = sel('id'), c = sel('properties[Colourway]');
      if(v && v.dataset.price){ price.textContent = v.dataset.price; }
      if(c){ cwName.textContent = c.value; }
      var design = document.getElementById('mccDesignImg');
      if(design && c && c.dataset.design && design.getAttribute('src') !== c.dataset.design){
        if(c.dataset.designSet){ design.srcset = c.dataset.designSet; } else { design.removeAttribute('srcset'); } design.src = c.dataset.design;
        design.alt = 'Carpet design in ' + c.value + ': a row of arched prayer spaces with a floral border';
      }
      if(carpet && lines){
        var spacing = v && v.dataset.spacing ? parseFloat(v.dataset.spacing) : 95, step = spacing / 100 * 33, s = '';
        for(var y = step; y < 420; y += step){ s += '<line x1="0" y1="' + y.toFixed(1) + '" x2="480" y2="' + y.toFixed(1) + '"/>'; }
        lines.innerHTML = s;
        if(c){ carpet.setAttribute('fill', c.dataset.colour); }
        cap.textContent = 'Illustration · ' + (coverage ? coverage.replace('Approx. ', '').replace(/ \(.*\)/, '') + ' · ' : '') + spacing + 'cm spacing · ' + (c ? c.value : '');
      }
    }
    form.addEventListener('change', update);
    update();

    // 3D roll: nothing loads until the buyer asks for it, so the page stays as fast as before.
    var bar = document.getElementById('mcc3dBar'), stage = document.getElementById('mcc3dStage'), open = document.getElementById('mcc3dOpen');
    var controls = document.getElementById('mcc3dControls'), note = document.getElementById('mcc3dNote'), msg = document.getElementById('mcc3dMsg');
    var rollBtn = document.getElementById('mcc3dRoll'), frac = document.getElementById('mcc3dFrac'), viewer = null;
    function webgl(){ try{ var c = document.createElement('canvas'); return !!(window.WebGLRenderingContext && (c.getContext('webgl') || c.getContext('experimental-webgl'))); }catch(e){ return false; } }
    function load(src){ return new Promise(function(ok, fail){ var s = document.createElement('script'); s.src = src; s.onload = ok; s.onerror = fail; document.head.appendChild(s); }); }
    function spacing(){ var v = sel('id'); return v && v.dataset.spacing ? parseFloat(v.dataset.spacing) / 100 : 0.95; }
    function show3d(on){
      stage.hidden = !on; controls.hidden = !on; note.hidden = !on; open.hidden = on;
      open.setAttribute('aria-expanded', on ? 'true' : 'false');
    }
    if(bar && webgl()){
      bar.hidden = false;
      open.addEventListener('click', function(){
        show3d(true); msg.hidden = false; msg.textContent = 'Loading the 3D roll…';
        var ready = window.THREE ? Promise.resolve() : load('https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js');
        ready.then(function(){ return window.MCCRoll3D ? null : load(bar.dataset.script); }).then(function(){
          if(viewer || stage.hidden) return;
          var c = sel('properties[Colourway]');
          viewer = MCCRoll3D.mount(stage, { texture: c.dataset.pattern, aspect: parseFloat(c.dataset.aspect), spacing: spacing(), length: 10,
            onChange: function(f){ frac.value = Math.round(f * 1000); rollBtn.textContent = f < 0.98 ? 'Unroll' : 'Roll up'; } });
          msg.hidden = true; document.getElementById('mcc3dWidth').textContent = Math.round(spacing() * 100); stage.focus();
        }).catch(function(){ msg.textContent = 'The 3D roll could not load. Check your connection and try again.'; });
      });
      document.getElementById('mcc3dClose').addEventListener('click', function(){ if(viewer){ viewer.destroy(); viewer = null; } show3d(false); open.focus(); });
      rollBtn.addEventListener('click', function(){ if(viewer) viewer.toggle(); });
      frac.addEventListener('input', function(){ if(viewer) viewer.setFraction(frac.value / 1000); });
      form.addEventListener('change', function(e){
        if(!viewer) return;
        if(e.target.name === 'properties[Colourway]') viewer.setPattern(e.target.dataset.pattern, parseFloat(e.target.dataset.aspect));
        if(e.target.name === 'id'){ viewer.setSpacing(spacing()); document.getElementById('mcc3dWidth').textContent = Math.round(spacing() * 100); }
      });
    }
    form.addEventListener('submit', function(){
      var btn = form.querySelector('button[type="submit"]');
      if(btn){ btn.setAttribute('aria-busy', 'true'); btn.textContent = 'Adding…'; }
    });
    var main = document.getElementById('mccMainImg');
    document.querySelectorAll('.mcc-thumb').forEach(function(t){
      t.addEventListener('click', function(){
        if(!main) return;
        main.removeAttribute('srcset');
        main.src = t.dataset.src; main.alt = t.dataset.alt;
        document.querySelectorAll('.mcc-thumb').forEach(function(x){ x.setAttribute('aria-current', x === t ? 'true' : 'false'); });
      });
    });
  }catch(e){ console.error('Product page error', e); }
})();
</script>

{% schema %}
{
  "name": "Mosque product page",
  "settings": [
    { "type": "text", "id": "price_note", "label": "Note next to price", "default": "carpet only · cut to your confirmed measurements" },
    { "type": "text", "id": "pile", "label": "Pile", "default": "Fire-rated wool blend" },
    { "type": "text", "id": "fire_rating", "label": "Fire rating", "default": "CAN/ULC-S102, ASTM E648" },
    { "type": "textarea", "id": "delivery_text", "label": "Delivery text", "default": "Your delivery window is confirmed in writing with your order, before anything is cut." },
    { "type": "textarea", "id": "payment_text", "label": "Payment text", "default": "Pay online, or by purchase order or bank transfer. We invoice in your mosque's registered name." }
  ]
}
{% endschema %}
