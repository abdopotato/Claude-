{{ 'mosque-design.css' | asset_url | stylesheet_tag }}
{{ 'mosque-update.css' | asset_url | stylesheet_tag }}
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Amiri:ital,wght@0,400;0,700;1,400&family=Work+Sans:wght@300;400;500;600&display=swap" rel="stylesheet">
<div id="mcc-app">
<div class="mcc-bismillah-bar mcc-ar">بِسْمِ اللَّهِ الرَّحْمَٰنِ الرَّحِيمِ</div>

<header>
  <div class="mcc-nav">
    <a class="mcc-logo" href="{{ routes.root_url }}">
      <div class="mcc-logo-mark">
        <svg viewBox="0 0 40 40" xmlns="http://www.w3.org/2000/svg" fill="none">
          <rect x="7" y="23" width="26" height="12" rx="1" fill="#FFFFFF"/>
          <path d="M13 23C13 15.8 16.5 11 20 11C23.5 11 27 15.8 27 23Z" fill="#FFFFFF"/>
          <rect x="19.2" y="6" width="1.6" height="5" fill="#FFFFFF"/>
          <circle cx="20" cy="5" r="1.5" fill="#FFFFFF"/>
          <rect x="30" y="17" width="3.2" height="18" fill="#FFFFFF"/>
          <path d="M30 17 L31.6 12.5 L33.2 17Z" fill="#FFFFFF"/>
        </svg>
      </div>
      <div class="mcc-logo-stack">
        <span>MosqueCarpetsCanada<span style="color:var(--brass);">.ca</span></span>
        <span class="mcc-logo-ar">سجاد المساجد</span>
      </div>
    </a>
    <a class="mcc-btn-primary mcc-btn-sm mcc-nav-quote" href="/pages/contact">Request a quote</a>
    {%- liquid
      assign p = request.path
      assign on_install = false
      assign on_about = false
      if p contains '/pages/installation'
        assign on_install = true
      elsif p contains '/pages/about'
        assign on_about = true
      endif
    -%}
    <nav class="mcc-navlinks" aria-label="Main">
      <a href="/pages/installation"{% if on_install %} aria-current="page"{% endif %}>Installation</a>
      <a href="/pages/about"{% if on_about %} aria-current="page"{% endif %}>About</a>
      <a href="{{ routes.root_url }}#faq">FAQ</a>
    </nav>
    <div class="mcc-navtools">
      <a class="mcc-cart-btn" href="{{ routes.cart_url }}" aria-label="Cart, {{ cart.item_count }} {{ cart.item_count | pluralize: 'item', 'items' }}">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M3 4h2l2.4 13.2a2 2 0 0 0 2 1.8h8.4a2 2 0 0 0 2-1.6L21 8H6"/><circle cx="9" cy="21" r="1"/><circle cx="18" cy="21" r="1"/></svg>
        <span class="mcc-cart-label">Cart</span>
        <span class="mcc-cart-count" data-count="{{ cart.item_count }}" aria-hidden="true">{{ cart.item_count }}</span>
      </a>
    </div>
  </div>
  <nav class="mcc-mobile-nav" aria-label="Main (mobile)">
    <a href="/pages/installation"{% if on_install %} aria-current="page"{% endif %}>Installation</a>
    <a href="/pages/about"{% if on_about %} aria-current="page"{% endif %}>About</a>
    <a href="{{ routes.root_url }}#faq">FAQ</a>
  </nav>
</header>
{%- if section.settings.whatsapp_number != blank -%}
  {%- assign wa = section.settings.whatsapp_number | remove: '+' | remove: ' ' | remove: '-' | remove: '(' | remove: ')' -%}
  <a class="mcc-whatsapp" href="https://wa.me/{{ wa }}?text={{ 'Salaam, I have a question about carpet for our prayer hall.' | url_encode }}" target="_blank" rel="noopener" aria-label="Chat with us on WhatsApp">
    <svg viewBox="0 0 24 24" width="26" height="26" aria-hidden="true"><path fill="currentColor" d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2zm0 18.2a8.2 8.2 0 0 1-4.2-1.2l-.3-.2-3 .8.8-2.9-.2-.3A8.2 8.2 0 1 1 12 20.2zm4.5-6.1c-.2-.1-1.5-.7-1.7-.8s-.4-.1-.6.1-.7.8-.8 1-.3.2-.5.1a6.7 6.7 0 0 1-3.3-2.9c-.3-.4.3-.4.7-1.4.1-.2 0-.3 0-.5l-.8-1.8c-.2-.5-.4-.4-.6-.4h-.5a1 1 0 0 0-.7.3 2.9 2.9 0 0 0-.9 2.2 5 5 0 0 0 1.1 2.7 11.6 11.6 0 0 0 4.4 3.9c1.6.7 2.3.8 3.1.6a2.6 2.6 0 0 0 1.7-1.2 2.1 2.1 0 0 0 .2-1.2c-.1-.1-.3-.2-.5-.3z"/></svg>
    <span>WhatsApp us</span>
  </a>
{%- endif -%}
{%- unless request.page_type == 'product' or request.path contains '/pages/contact' -%}
  <div class="mcc-mobile-cta" id="mccMobileCta"><a class="mcc-btn-primary" href="/pages/contact">Request a quote</a></div>
{%- endunless -%}
</div>
<script>
  (function(){
    try{
      var root = document.documentElement;
      root.classList.add('mcc-js');
      var header = document.querySelector('#mcc-app header');
      var bar = document.getElementById('mccMobileCta');
      function onScroll(){
        if(header){ header.classList.toggle('is-scrolled', window.scrollY > 8); }
        if(bar){ bar.classList.toggle('is-visible', window.scrollY > 480); }
      }
      window.addEventListener('scroll', onScroll, { passive: true });
      onScroll();
      function reveal(){
        var items = document.querySelectorAll('#mcc-app [data-reveal]');
        if(!('IntersectionObserver' in window)){ items.forEach(function(el){ el.classList.add('is-in'); }); return; }
        var io = new IntersectionObserver(function(entries){
          entries.forEach(function(e){ if(e.isIntersecting){ e.target.classList.add('is-in'); io.unobserve(e.target); } });
        }, { rootMargin: '0px 0px -8% 0px', threshold: 0.12 });
        items.forEach(function(el){ io.observe(el); });
      }
      if(document.readyState === 'loading'){ document.addEventListener('DOMContentLoaded', reveal); } else { reveal(); }
    }catch(e){ document.documentElement.classList.remove('mcc-js'); console.error('Header script error', e); }
  })();
</script>
{% schema %}
{
  "name": "Mosque header",
  "settings": [
    { "type": "text", "id": "whatsapp_number", "label": "WhatsApp number (shows a chat button)", "info": "Include the country code, e.g. +1 416 555 0123. Leave blank to hide the button." }
  ]
}
{% endschema %}
