{{ 'mosque-design.css' | asset_url | stylesheet_tag }}
{{ 'mosque-update.css' | asset_url | stylesheet_tag }}
<div id="mcc-app">
<section class="mcc-phero"><div class="mcc-wrap">
  <span class="mcc-eyebrow">Hall planning</span>
  <h1>{{ section.settings.heading }}</h1>
  <p>{{ section.settings.intro }}</p>
  <div class="mcc-hero-actions"><a href="/pages/contact" class="mcc-btn-primary">Request a quote</a><a href="#calculator" class="mcc-btn-ghost">Try the fit calculator</a></div>
</div></section>

{%- if page.content != blank -%}
<section style="padding:0 0 40px;"><div class="mcc-wrap mcc-rte">{{ page.content }}</div></section>
{%- endif -%}

<section class="mcc-section mcc-process"><div class="mcc-wrap">
  <div class="mcc-section-head" data-reveal><h2>How we plan your order</h2></div>
  <div class="mcc-steps">
    <div class="mcc-step" data-reveal><div class="mcc-step-num">1</div><h3>Measure</h3><p>Send your hall's width and length, or a floor plan, with the qibla wall, doors and pillars marked.</p></div>
    <div class="mcc-step" data-reveal><div class="mcc-step-num">2</div><h3>Choose a spacing</h3><p>We recommend 90, 95 or 100cm rows for how your congregation prays.</p></div>
    <div class="mcc-step" data-reveal><div class="mcc-step-num">3</div><h3>Plan the rolls</h3><p>We choose the roll widths so seams fall between prayer rows and the lines match across every join.</p></div>
    <div class="mcc-step" data-reveal><div class="mcc-step-num">4</div><h3>Cut &amp; deliver</h3><p>Rolls are cut only after your measurements are confirmed, then delivered to your mosque with the layout drawing.</p></div>
  </div>
</div></section>

<section class="mcc-section"><div class="mcc-wrap mcc-two">
  <div class="mcc-prose">
    <h2>We supply the carpet, planned for your hall</h2>
    <p>We supply luxury carpet rolls only. Every order comes with a layout drawing showing the roll widths, the seam positions and where each saff line falls, set out from the qibla wall.</p>
    <p>Service area: {{ section.settings.service_area }}.</p>
  </div>
  <div>
    <h3 style="font-family:'Amiri',serif; font-size:22px; margin-bottom:14px;">What to send us for a quote</h3>
    <ul class="mcc-checklist">
      <li>Hall width and length in metres, wall to wall</li>
      <li>Which wall faces the qibla</li>
      <li>Doors, pillars, heating vents, floor boxes or the minbar base</li>
      <li>The row spacing you use now, if you know it</li>
      <li>A colourway you like, or "not sure yet"</li>
    </ul>
  </div>
</div></section>

<section class="mcc-section mcc-band" id="calculator">
  <div class="mcc-wrap">
    <div class="mcc-section-head" data-reveal>
      <h2>Fit calculator</h2>
      <p>Enter your hall's floor size for a rough row count and price range, then send the numbers to us for an exact quote.</p>
    </div>
    <div class="mcc-calc">
      <div class="mcc-calc-form">
        <label for="hw">Hall width (metres)</label>
        <input type="number" id="hw" value="12" min="1" step="0.1" inputmode="decimal">
        <label for="hl">Hall length, front to back (metres)</label>
        <input type="number" id="hl" value="8" min="1" step="0.1" inputmode="decimal">
        <label for="sp">Row spacing</label>
        <select id="sp">
          <option value="90">90cm, tighter halls</option>
          <option value="95" selected>95cm, recommended</option>
          <option value="100">100cm, Jumu'ah &amp; Eid halls</option>
        </select>
      </div>
      <div class="mcc-calc-result">
        <div class="mcc-num" id="rowCount" aria-live="polite">8</div>
        <div class="mcc-label">prayer rows fit at this spacing</div>
        <div class="mcc-note" id="calcNote"></div>
        <a href="/pages/contact" class="mcc-btn-primary" id="calcSend">Request a quote with these numbers</a>
      </div>
    </div>
  </div>
</section>
<section class="mcc-cta mcc-on-dark" data-reveal><div><h2>Send us your hall size</h2><p>We'll recommend a spacing, plan the rolls and send an itemised quote.</p></div><div class="mcc-cta-actions"><a href="/pages/contact" class="mcc-btn-primary">Request a quote</a><p class="mcc-cta-note">Free and itemised, with no obligation.</p></div></section>
</div>
<script>
  (function(){
    try{
      var hw = document.getElementById('hw'), hl = document.getElementById('hl'), sp = document.getElementById('sp');
      var rowCount = document.getElementById('rowCount'), calcNote = document.getElementById('calcNote'), send = document.getElementById('calcSend');
      function recalc(){
        var width = parseFloat(hw.value) || 0, length = parseFloat(hl.value) || 0, spacing = parseFloat(sp.value) / 100;
        var rows = spacing > 0 ? Math.max(0, Math.floor(length / spacing)) : 0;
        var area = width * length;
        rowCount.textContent = rows;
        calcNote.textContent = '≈ ' + area.toFixed(0) + 'm² of carpet. Carpet supply is typically $' + Math.round(area * 30).toLocaleString('en-CA') + '–$' + Math.round(area * 48).toLocaleString('en-CA') + ' CAD.';
        send.href = '/pages/contact?w=' + encodeURIComponent(hw.value) + '&l=' + encodeURIComponent(hl.value) + '&s=' + encodeURIComponent(sp.value);
      }
      [hw, hl, sp].forEach(function(el){ el.addEventListener('input', recalc); });
      recalc();
    }catch(e){ console.error('Calculator error', e); }
  })();
</script>
{% schema %}
{
  "name": "Hall planning page",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Planned so the saff falls where it should" },
    { "type": "textarea", "id": "intro", "label": "Intro", "default": "We supply luxury carpet rolls only, and every order is planned around your hall. We work from your measurements to choose the spacing and the roll widths, so seams sit between rows and the prayer lines run square to the qibla wall." },
    { "type": "text", "id": "service_area", "label": "Service area", "default": "we supply mosques across Canada" }
  ],
  "presets": [{ "name": "Hall planning page" }]
}
{% endschema %}
