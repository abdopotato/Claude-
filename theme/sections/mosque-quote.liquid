{{ 'mosque-design.css' | asset_url | stylesheet_tag }}
{{ 'mosque-update.css' | asset_url | stylesheet_tag }}
<div id="mcc-app">
<section class="mcc-phero" style="padding-bottom:28px;"><div class="mcc-wrap">
  <span class="mcc-eyebrow">Free, itemised quote</span>
  <h1>{{ section.settings.heading }}</h1>
  <p>{{ section.settings.intro }}</p>
</div></section>

<div class="mcc-wrap mcc-quote-grid">
  {%- form 'contact', id: 'mcc-quote-form', class: 'mcc-form' -%}
    {%- if form.posted_successfully? -%}
      <div class="mcc-form-ok mcc-full" role="status" tabindex="-1" id="mccQuoteOk">Thank you. We've received your request and will reply by email with next steps.</div>
    {%- endif -%}
    {%- if form.errors -%}
      <div class="mcc-form-error mcc-full" role="alert">{{ form.errors | default_errors }}</div>
    {%- endif -%}
    <div><label for="q-name">Your name<span class="mcc-req" aria-hidden="true">*</span></label><input id="q-name" name="contact[name]" autocomplete="name" required></div>
    <div><label for="q-org">Mosque / organisation</label><input id="q-org" name="contact[Mosque or organisation]" autocomplete="organization"></div>
    <div><label for="q-email">Email<span class="mcc-req" aria-hidden="true">*</span></label><input id="q-email" type="email" name="contact[email]" autocomplete="email" required></div>
    <div><label for="q-phone">Phone</label><input id="q-phone" type="tel" name="contact[phone]" autocomplete="tel"></div>
    <div><label for="q-city">City &amp; province</label><input id="q-city" name="contact[City and province]" autocomplete="address-level2" placeholder="e.g. Mississauga, ON"></div>
    <div><label for="q-need">What do you need?</label>
      <select id="q-need" name="contact[Request type]">
        <option value="Quote: supply + install">Quote: supply + install</option>
        <option value="Quote: supply only">Quote: supply only</option>
        <option value="Site visit">Site visit</option>
        <option value="Samples">Samples</option>
      </select></div>
    <div><label for="q-w">Hall width (m)</label><input id="q-w" type="number" step="0.1" min="0" inputmode="decimal" name="contact[Hall width (m)]" placeholder="e.g. 12"></div>
    <div><label for="q-l">Hall length, front to back (m)</label><input id="q-l" type="number" step="0.1" min="0" inputmode="decimal" name="contact[Hall length (m)]" placeholder="e.g. 8"></div>
    <div><label for="q-s">Row spacing</label>
      <select id="q-s" name="contact[Row spacing]">
        <option value="Not sure">Not sure, recommend one</option>
        <option value="90cm">90cm</option>
        <option value="95cm" selected>95cm</option>
        <option value="100cm">100cm</option>
      </select></div>
    <div><label for="q-c">Colourway</label>
      <select id="q-c" name="contact[Colourway]">
        <option>Not sure yet</option><option>Masjid Green</option><option>Maroon</option><option>Deep Indigo</option><option>Walnut Brown</option><option>Camel Gold</option>
      </select></div>
    <input type="hidden" id="q-product" name="contact[Product]" value="">
    <div class="mcc-full"><label for="q-body">Anything else? (old carpet removal, timing, floor plan link)</label><textarea id="q-body" name="contact[body]"></textarea></div>
    <div class="mcc-full" style="display:flex; gap:16px; align-items:center; flex-wrap:wrap;"><button class="mcc-btn-primary" type="submit">Request a quote</button><span class="mcc-fine"><span class="mcc-req" aria-hidden="true">*</span> Required. We reply by email with next steps.</span></div>
  {%- endform -%}

  <aside class="mcc-side">
    <h3>What happens next</h3>
    <ol>
      <li><b>We review your hall</b>, spacing and colour preferences.</li>
      <li><b>We send a layout and an itemised quote</b> with supply-only and supply + install prices.</li>
      <li><b>You check samples</b> with your committee.</li>
      <li><b>We confirm measurements</b>, then order and schedule your install.</li>
    </ol>
    {%- if section.settings.contact_line != blank -%}<p class="mcc-contact-line">{{ section.settings.contact_line }}</p>{%- endif -%}
  </aside>
</div>
</div>
<script>
(function(){
  try{
    var q = new URLSearchParams(location.search);
    function set(id, v){ var el = document.getElementById(id); if(el && v){ el.value = v; } }
    set('q-w', q.get('w')); set('q-l', q.get('l'));
    if(q.get('s')){ set('q-s', q.get('s') + 'cm'); }
    set('q-c', q.get('colour'));
    set('q-product', q.get('product'));
    var need = { 'samples': 'Samples', 'site-visit': 'Site visit' }[q.get('need')];
    set('q-need', need);
    var ok = document.getElementById('mccQuoteOk');
    if(ok){ ok.focus(); }
    var f = document.getElementById('mcc-quote-form');
    if(f){ f.addEventListener('submit', function(){ var b = f.querySelector('button[type="submit"]'); if(b){ b.setAttribute('aria-busy', 'true'); b.textContent = 'Sending…'; } }); }
  }catch(e){ console.error('Quote form prefill error', e); }
})();
</script>
{% schema %}
{
  "name": "Quote request",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Request a quote or site visit" },
    { "type": "textarea", "id": "intro", "label": "Intro", "default": "Tell us about your hall. Rough numbers are fine, because we confirm everything before anything is cut." },
    { "type": "text", "id": "contact_line", "label": "Phone / WhatsApp line (optional)" }
  ],
  "presets": [{ "name": "Quote request" }]
}
{% endschema %}
