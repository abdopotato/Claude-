{{ 'mosque-design.css' | asset_url | stylesheet_tag }}
{{ 'mosque-update.css' | asset_url | stylesheet_tag }}
{%- assign star = '<svg viewBox="0 0 40 40"><path d="M20 2 L24 14 L36 10 L27 19 L38 24 L25 25 L28 37 L20 28 L12 37 L15 25 L2 24 L13 19 L4 10 L16 14 Z" fill="var(--brass)"/></svg>' -%}
<div id="mcc-app">
<section class="mcc-hero">
  <div class="mcc-hero-skyline" aria-hidden="true">
    <svg viewBox="0 0 1400 220" preserveAspectRatio="none" xmlns="http://www.w3.org/2000/svg">
      <path d="M0 220 V150 L40 150 L40 120 A20 20 0 0 1 80 120 L80 150 L110 150 L110 90 A55 55 0 0 1 220 90 L220 150 L260 150 L260 130 L280 100 L300 130 L300 150 L360 150 L360 60 A70 70 0 0 1 500 60 L500 150 L540 150 L540 125 L560 95 L580 125 L580 150 L660 150 L660 40 A85 85 0 0 1 830 40 L830 150 L870 150 L870 128 L890 98 L910 128 L910 150 L980 150 L980 75 A60 60 0 0 1 1100 75 L1100 150 L1140 150 L1140 132 L1160 100 L1180 132 L1180 150 L1400 150 V220 Z" fill="var(--green-900)"/>
      <circle cx="80" cy="112" r="6" fill="var(--brass)" opacity="0.4"/>
      <circle cx="430" cy="52" r="7" fill="var(--brass)" opacity="0.4"/>
      <circle cx="745" cy="32" r="8" fill="var(--brass)" opacity="0.4"/>
      <circle cx="1040" cy="67" r="6" fill="var(--brass)" opacity="0.4"/>
    </svg>
  </div>

  <div class="mcc-hero-inner">
    <div class="mcc-hero-copy">
      <div class="mcc-trust-badge"><span class="mcc-dot"></span>{{ section.settings.trust_text }}</div>
      <div class="mcc-kicker">{{ section.settings.kicker }}</div>
      <h1>{{ section.settings.heading }}</h1>
      <p>{{ section.settings.text }}</p>
      <div class="mcc-hero-actions">
        <a href="/pages/contact" class="mcc-btn-primary">Request a quote</a>
        <a href="#sizes" class="mcc-btn-ghost">Shop by hall size</a>
      </div>
      <p class="mcc-cta-note" style="margin-top:12px;">{{ section.settings.cta_note }}</p>
      <div class="mcc-hero-mini-stats">
        <div><strong>{{ section.settings.stat_1_value }}</strong><span>{{ section.settings.stat_1_label }}</span></div>
        <div><strong>{{ section.settings.stat_2_value }}</strong><span>{{ section.settings.stat_2_label }}</span></div>
        <div><strong>{{ section.settings.stat_3_value }}</strong><span>{{ section.settings.stat_3_label }}</span></div>
      </div>
    </div>

    <div class="mcc-hero-card" style="--r:0deg;">
      <svg viewBox="0 0 280 340" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
        <defs>
          <linearGradient id="archfill2" x1="0" y1="0" x2="0" y2="1"><stop offset="0%" stop-color="#204A40"/><stop offset="100%" stop-color="#0F2822"/></linearGradient>
          <pattern id="saffLines2" width="280" height="20" patternUnits="userSpaceOnUse"><line x1="0" y1="0" x2="280" y2="0" stroke="#B8892F" stroke-width="1" opacity="0.5"/></pattern>
        </defs>
        <rect x="0" y="0" width="280" height="340" rx="20" fill="url(#archfill2)"/>
        <rect x="0" y="0" width="280" height="340" rx="20" fill="url(#saffLines2)"/>
        <path d="M40 300 V160 C40 90 85 45 140 45 C195 45 240 90 240 160 V300" fill="none" stroke="#D7AE5C" stroke-width="1.4" opacity="0.6"/>
        <g transform="translate(56,268)">
          <rect x="0" y="0" width="168" height="42" rx="6" fill="#5C2A2A"/>
          <rect x="0" y="0" width="168" height="42" rx="6" fill="none" stroke="#B8892F" stroke-width="1.3"/>
          <ellipse cx="4" cy="21" rx="9" ry="21" fill="#7A3434"/>
          <ellipse cx="4" cy="21" rx="9" ry="21" fill="none" stroke="#D7AE5C" stroke-width="1.2"/>
          <ellipse cx="164" cy="21" rx="9" ry="21" fill="#4E2323"/>
        </g>
      </svg>
      <div class="mcc-hero-card-tag">95cm spacing<span class="mcc-ar">— جاهز للفرش</span></div>
    </div>
  </div>
</section>

<div class="mcc-divider-stars" aria-hidden="true">{{ star }}{{ star }}{{ star }}</div>

<div class="mcc-strip">
  <div class="mcc-wrap">
    <div class="mcc-strip-item"><strong>Woven-in saff lines</strong>True 90 / 95 / 100cm spacing, woven in and never printed</div>
    <div class="mcc-strip-item"><strong>Professional installation</strong>Measured, seamed and fitted by our crew</div>
    <div class="mcc-strip-item"><strong>Fire rated</strong>{{ section.settings.fire_rating }}</div>
    <div class="mcc-strip-item"><strong>Committee invoicing</strong>{{ section.settings.payment_text }}</div>
  </div>
</div>

<section class="mcc-section mcc-tight-top" id="sizes">
  <div class="mcc-wrap">
    <div class="mcc-section-head" data-reveal>
      <h2>{{ section.settings.sizes_heading }}</h2>
      <p>{{ section.settings.sizes_text }}</p>
    </div>
    <div class="mcc-size-carousel" data-size-carousel data-reveal role="region" aria-roledescription="carousel" aria-label="Hall sizes">
    <button type="button" class="mcc-carousel-nav mcc-carousel-prev" data-carousel-prev aria-label="Previous hall size" hidden>&#8249;</button>
    <div class="mcc-grid-by-size" data-carousel-track>
      {%- for block in section.blocks -%}
        {%- if block.type != 'hall_size' -%}{%- continue -%}{%- endif -%}
        {%- assign p = block.settings.product -%}
        {%- if p != blank -%}{%- assign card_url = p.url -%}{%- else -%}{%- assign card_url = routes.all_products_collection_url -%}{%- endif -%}
        <article class="mcc-size-card{% if block.settings.popular %} mcc-pop{% endif %}" data-carousel-card aria-roledescription="slide" {{ block.shopify_attributes }}>
          {%- if block.settings.popular -%}<span class="mcc-pop-tag">Most ordered</span>{%- endif -%}
          <div class="mcc-card-media">
            {%- if p != blank and p.featured_media -%}
              {%- assign alt = p.featured_media.alt | default: p.title -%}
              {{ p.featured_media.preview_image | image_url: width: 900 | image_tag: loading: 'lazy', widths: '400, 600, 900', sizes: '(min-width: 900px) 360px, 100vw', alt: alt }}
            {%- else -%}
              {%- assign rows_n = forloop.index | times: 3 | plus: 4 -%}
              <svg viewBox="0 0 320 180" aria-hidden="true" preserveAspectRatio="xMidYMid slice">
                <rect width="320" height="180" fill="#0F2822"/>
                <g transform="translate(40,26)"><rect width="240" height="128" rx="4" fill="#16352E" stroke="#B8892F" stroke-opacity=".35"/>
                  <g stroke="#B8892F" stroke-opacity=".7">{%- for r in (1..rows_n) -%}{%- assign y = 128 | times: r | divided_by: rows_n | plus: 0 -%}{%- if y < 128 -%}<line x1="0" y1="{{ y }}" x2="240" y2="{{ y }}"/>{%- endif -%}{%- endfor -%}</g>
                </g>
              </svg>
            {%- endif -%}
          </div>
          <div class="mcc-size-head">
            <div class="mcc-dims">{{ block.settings.dims }}<span> {{ block.settings.unit }}</span></div>
            {%- if block.settings.arabic != blank -%}<div class="mcc-dims-ar">{{ block.settings.arabic }}</div>{%- endif -%}
          </div>
          <h3><a class="mcc-card-title-link" href="{{ card_url }}">{{ block.settings.title }}</a></h3>
          <p>{{ block.settings.description }}</p>
          {%- if block.settings.rows != blank -%}<div class="mcc-rows">{{ block.settings.rows }}</div>{%- endif -%}
          {%- if block.settings.include_1 != blank or block.settings.include_2 != blank -%}
            <ul class="mcc-incl">
              {%- if block.settings.include_1 != blank -%}<li>{{ block.settings.include_1 }}</li>{%- endif -%}
              {%- if block.settings.include_2 != blank -%}<li>{{ block.settings.include_2 }}</li>{%- endif -%}
            </ul>
          {%- endif -%}
          <div class="mcc-buy-box">
            <div class="mcc-buy-top">
              <span class="mcc-buy-label">Buy online</span>
              <span class="mcc-price">{% if p != blank %}from {{ p.price_min | money_without_trailing_zeros }} {{ cart.currency.iso_code }}{% else %}{{ block.settings.price_text }}{% endif %}</span>
            </div>
            {%- if p != blank and p.available -%}
              <a class="mcc-btn-primary mcc-buy-btn" href="{{ p.url }}" aria-label="Buy now: {{ block.settings.title | escape }}">Buy now</a>
              <p class="mcc-buy-note">Choose row spacing, colourway and installation on the next step.</p>
            {%- else -%}
              <a class="mcc-btn-primary mcc-buy-btn" href="/pages/contact{% if p != blank %}?product={{ p.handle | url_encode }}{% endif %}">Request a quote</a>
              <p class="mcc-buy-note">Online ordering for this size opens soon.</p>
            {%- endif -%}
            <a class="mcc-buy-quote" href="/pages/contact{% if p != blank %}?product={{ p.handle | url_encode }}{% endif %}">Prefer a quote first?</a>
          </div>
        </article>
      {%- endfor -%}
    </div>
    <button type="button" class="mcc-carousel-nav mcc-carousel-next" data-carousel-next aria-label="Next hall size" hidden>&#8250;</button>
    <p class="mcc-visually-hidden" aria-live="polite" data-carousel-status></p>
    <svg class="mcc-blur-defs" width="0" height="0" aria-hidden="true" focusable="false"><filter id="mccMotionBlur" x="-20%" y="0" width="140%" height="100%"><feGaussianBlur in="SourceGraphic" stdDeviation="0 0"/></filter></svg>
    </div>
  </div>
</section>

<section class="mcc-section mcc-flush-top" id="sourcing">
  <div class="mcc-wrap mcc-source">
    <div class="mcc-source-visual" data-reveal>
      {%- if section.settings.sourcing_image != blank -%}
        {{ section.settings.sourcing_image | image_url: width: 1200 | image_tag: loading: 'lazy', alt: section.settings.sourcing_image.alt }}
      {%- else -%}
        <svg viewBox="0 0 500 400" preserveAspectRatio="xMidYMid slice" aria-hidden="true"><rect width="500" height="400" fill="#0F2822"/>
          <g transform="translate(70,120)">
            <rect x="0" y="120" width="300" height="56" rx="6" fill="#5C2A2A"/><ellipse cx="300" cy="148" rx="14" ry="28" fill="#7A3434" stroke="#D7AE5C"/><g stroke="#B8892F" opacity=".5"><line x1="0" y1="134" x2="300" y2="134"/><line x1="0" y1="162" x2="300" y2="162"/></g>
            <rect x="30" y="60" width="300" height="56" rx="6" fill="#16352E"/><ellipse cx="330" cy="88" rx="14" ry="28" fill="#204A40" stroke="#D7AE5C"/><g stroke="#B8892F" opacity=".5"><line x1="30" y1="74" x2="330" y2="74"/><line x1="30" y1="102" x2="330" y2="102"/></g>
            <rect x="60" y="0" width="300" height="56" rx="6" fill="#1B2A4A"/><ellipse cx="360" cy="28" rx="14" ry="28" fill="#27406B" stroke="#D7AE5C"/><g stroke="#B8892F" opacity=".5"><line x1="60" y1="14" x2="360" y2="14"/><line x1="60" y1="42" x2="360" y2="42"/></g>
          </g>
          <g stroke="#B8892F" stroke-width="1" opacity=".3" fill="none"><path d="M0 360 Q250 300 500 360"/><path d="M0 380 Q250 320 500 380"/></g></svg>
      {%- endif -%}
    </div>
    <div data-reveal>
      <span class="mcc-eyebrow">{{ section.settings.sourcing_kicker }}</span>
      <h2 style="font-size:clamp(28px,3.2vw,38px);">{{ section.settings.sourcing_heading }}</h2>
      <p style="margin-top:14px; color:var(--text-dim); max-width:50ch;">{{ section.settings.sourcing_text }}</p>
      <div class="mcc-pillars">
        <div class="mcc-pillar"><strong>Hand-selected mills</strong><span>Partners chosen for consistent quality, run after run</span></div>
        <div class="mcc-pillar"><strong>Inspected on arrival</strong><span>Every roll is checked before it's cut</span></div>
        <div class="mcc-pillar"><strong>Import handled</strong><span>Freight, duties and customs are itemised in your quote</span></div>
        <div class="mcc-pillar"><strong>The right carpet, not the nearest</strong><span>We match the mill to your hall's needs and budget</span></div>
      </div>
    </div>
  </div>
</section>

<section class="mcc-section mcc-process">
  <div class="mcc-wrap">
    <div class="mcc-section-head" data-reveal><span class="mcc-eyebrow">From the mill to your masjid</span><h2>Four steps. One team.</h2></div>
    <div class="mcc-steps">
      <div class="mcc-step" data-reveal><div class="mcc-step-num">1</div><h3>Measure &amp; quote</h3><p>Send your floor plan or book a site visit. We'll recommend a spacing and roll layout.</p><span class="mcc-when">Free, itemised quote</span></div>
      <div class="mcc-step" data-reveal><div class="mcc-step-num">2</div><h3>Choose your carpet</h3><p>Pick a colourway and row spacing. Samples are available for your committee.</p><span class="mcc-when">See it before you commit</span></div>
      <div class="mcc-step" data-reveal><div class="mcc-step-num">3</div><h3>We import &amp; deliver</h3><p>Rolls are shipped, cleared through customs and inspected in Canada.</p><span class="mcc-when">{{ section.settings.lead_time_text }}</span></div>
      <div class="mcc-step" data-reveal><div class="mcc-step-num">4</div><h3>Professional install</h3><p>Our crew fits the carpet with the saff lines squared to the qibla wall.</p><span class="mcc-when">Scheduled around salah</span></div>
    </div>
  </div>
</section>

<section class="mcc-saff-section" id="saff">
  <div class="mcc-wrap">
    <div class="mcc-saff-copy" data-reveal>
      <span class="mcc-ar mcc-saff-kicker">الصف</span>
      <h2>The line spacing is the whole point</h2>
      <p>A carpet that looks right in a photo but crowds the saff makes every rak'ah harder. Every roll we supply comes in three woven spacings, and we'll help you choose the right one before you order.</p>
      <ul class="mcc-saff-facts">
        <li class="mcc-saff-fact"><span class="mcc-saff-fact-num">90</span><div class="mcc-saff-fact-body"><strong>90cm</strong><span>Tight halls, high midweek attendance, smaller-framed congregations</span></div></li>
        <li class="mcc-saff-fact mcc-saff-fact-rec"><span class="mcc-saff-fact-num">95</span><div class="mcc-saff-fact-body"><strong>95cm <em class="mcc-saff-fact-tag">Recommended</em></strong><span>The standard we recommend for most mosques: comfortable sujood without wasted floor</span></div></li>
        <li class="mcc-saff-fact"><span class="mcc-saff-fact-num">100</span><div class="mcc-saff-fact-body"><strong>100cm</strong><span>Jumu'ah and Eid halls where rows need extra room for movement</span></div></li>
      </ul>
    </div>
    <div class="mcc-saff-diagram-wrap">
      <svg class="mcc-saff-diagram" viewBox="0 0 480 300" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
        <rect x="0" y="0" width="480" height="300" fill="#0F2822"/>
        <g stroke="#B8892F" stroke-width="1.4">
          {%- for y in (0..4) -%}<line x1="30" y1="{{ y | times: 57 | plus: 40 }}" x2="450" y2="{{ y | times: 57 | plus: 40 }}"/>{%- endfor -%}
        </g>
        <g fill="#7C9A87" opacity="0.85">
          {%- for r in (0..3) -%}{%- for c in (0..5) -%}<ellipse cx="{{ c | times: 60 | plus: 70 }}" cy="{{ r | times: 57 | plus: 62 }}" rx="14" ry="7"/>{%- endfor -%}{%- endfor -%}
        </g>
      </svg>
      <div class="mcc-saff-diagram-tag">95cm spacing</div>
    </div>
  </div>
</section>

<section class="mcc-section" id="install">
  <div class="mcc-wrap mcc-install">
    <div>
      <div class="mcc-section-head" style="margin-bottom:28px;" data-reveal><span class="mcc-eyebrow">Fitted, not just delivered</span><h2>Installation by people who understand a prayer hall</h2><p>A luxury carpet only looks luxurious if it's laid right. Our installers square the saff lines to the qibla wall first, then work outwards, so every row runs true.</p></div>
      <ul class="mcc-install-list">
        <li><strong>Qibla alignment</strong><span>Lines squared to the qibla wall, not to the room</span></li>
        <li><strong>Hidden seams</strong><span>Joins placed between rows, where no one kneels</span></li>
        <li><strong>Old carpet removal</strong><span>Can be added to your quote</span></li>
        <li><strong>Minimal disruption</strong><span>Scheduled around salah times and Jumu'ah</span></li>
      </ul>
    </div>
    <aside class="mcc-install-card mcc-on-dark" data-reveal>
      <h3>Two ways to order</h3>
      <p>Every quote shows both options, so your committee can compare.</p>
      <div class="mcc-opt"><span>Supply + install</span><span>Our carpet, fitted by our crew</span></div>
      <div class="mcc-opt"><span>Supply only</span><span>Our carpet, your installer</span></div>
      <div class="mcc-opt"><span>Where</span><span>{{ section.settings.service_area }}</span></div>
      <a href="/pages/installation" class="mcc-btn-secondary">How installation works</a>
    </aside>
  </div>
</section>

<section class="mcc-section mcc-flush-top" id="colours">
  <div class="mcc-wrap">
    <div class="mcc-section-head" data-reveal>
      <h2>Colourways</h2>
      <p>Each colourway is dyed and woven as one production run at the mill, so pile depth and line contrast match across your whole order. Tap a shade to ask about samples.</p>
    </div>
    <div class="mcc-colorways">
      <button type="button" class="mcc-swatch" data-name="Masjid Green" aria-pressed="false"><div class="mcc-block" style="background:#0F2822"></div><p>Masjid Green</p><div class="mcc-ar-name">أخضر</div><span>Our most-ordered shade</span></button>
      <button type="button" class="mcc-swatch" data-name="Maroon" aria-pressed="false"><div class="mcc-block" style="background:#5C2A2A"></div><p>Maroon</p><div class="mcc-ar-name">عنابي</div><span>Traditional, low-glare</span></button>
      <button type="button" class="mcc-swatch" data-name="Deep Indigo" aria-pressed="false"><div class="mcc-block" style="background:#1B2A4A"></div><p>Deep Indigo</p><div class="mcc-ar-name">نيلي</div><span>Evening-lit halls</span></button>
      <button type="button" class="mcc-swatch" data-name="Walnut Brown" aria-pressed="false"><div class="mcc-block" style="background:#3B2A17"></div><p>Walnut Brown</p><div class="mcc-ar-name">بني</div><span>Hides daily foot traffic</span></button>
      <button type="button" class="mcc-swatch" data-name="Camel Gold" aria-pressed="false"><div class="mcc-block" style="background:#8A6A2E"></div><p>Camel Gold</p><div class="mcc-ar-name">ذهبي</div><span>Bright, south-facing halls</span></button>
    </div>
    <p class="mcc-colorway-preview" id="mccColorwayPreview" aria-live="polite"></p>
  </div>
</section>

<section class="mcc-section mcc-flush-top" id="calculator">
  <div class="mcc-wrap">
    <div class="mcc-section-head" data-reveal>
      <h2>Fit calculator</h2>
      <p>Enter your hall's floor size for a rough row count and price range, then send the numbers to us for an exact quote.</p>
    </div>
    <div class="mcc-calc">
      <div class="mcc-calc-form">
        <label for="hw">Hall width (metres)</label>
        <input type="number" id="hw" value="12" min="1" step="0.1" inputmode="decimal">
        <label for="hl">Hall length, front to back (metres)</label>
        <input type="number" id="hl" value="8" min="1" step="0.1" inputmode="decimal">
        <label for="sp">Row spacing</label>
        <select id="sp">
          <option value="90">90cm, tighter halls</option>
          <option value="95" selected>95cm, recommended</option>
          <option value="100">100cm, Jumu'ah &amp; Eid halls</option>
        </select>
      </div>
      <div class="mcc-calc-result">
        <div class="mcc-num" id="rowCount" aria-live="polite">8</div>
        <div class="mcc-label">prayer rows fit at this spacing</div>
        <div class="mcc-note" id="calcNote"></div>
        <a href="/pages/contact" class="mcc-btn-primary" id="calcSend">Request a quote with these numbers</a>
      </div>
    </div>
  </div>
</section>

{%- if section.settings.testimonial_quote != blank -%}
<section class="mcc-testimonial">
  <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M7 7h5v5c0 3-2 5-5 5v-2c1.5 0 2.5-1 2.5-2.5H7V7zm9 0h5v5c0 3-2 5-5 5v-2c1.5 0 2.5-1 2.5-2.5H16V7z"/></svg>
  <p>{{ section.settings.testimonial_quote }}</p>
  <cite>{{ section.settings.testimonial_author }}</cite>
</section>
{%- endif -%}

<section class="mcc-section mcc-flush-top" id="faq">
  <div class="mcc-wrap">
    <div class="mcc-section-head" data-reveal><h2>Questions committees ask us</h2></div>
    <div class="mcc-faq">
      {%- for block in section.blocks -%}
        {%- if block.type != 'faq' -%}{%- continue -%}{%- endif -%}
        <details {% if forloop.first %}open{% endif %} {{ block.shopify_attributes }}><summary>{{ block.settings.question }}</summary><p>{{ block.settings.answer }}</p></details>
      {%- endfor -%}
    </div>
  </div>
</section>

<section class="mcc-cta mcc-on-dark" data-reveal>
  <div><h2>{{ section.settings.cta_heading }}</h2><p>{{ section.settings.cta_text }}</p></div>
  <div class="mcc-cta-actions"><a href="/pages/contact" class="mcc-btn-primary">Request a quote</a><a href="/pages/contact?need=samples" class="mcc-btn-ghost">Ask about samples</a><p class="mcc-cta-note">{{ section.settings.cta_note }}</p></div>
</section>
</div>
<script>
  (function(){
    try{
      var hw = document.getElementById('hw'), hl = document.getElementById('hl'), sp = document.getElementById('sp');
      var rowCount = document.getElementById('rowCount'), calcNote = document.getElementById('calcNote'), send = document.getElementById('calcSend');
      function recalc(){
        var width = parseFloat(hw.value) || 0, length = parseFloat(hl.value) || 0, spacing = parseFloat(sp.value) / 100;
        var rows = spacing > 0 ? Math.max(0, Math.floor(length / spacing)) : 0;
        var area = width * length;
        rowCount.textContent = rows;
        calcNote.textContent = '≈ ' + area.toFixed(0) + 'm² of carpet, typically CAD $' + Math.round(area * 34).toLocaleString() + '–$' + Math.round(area * 44).toLocaleString() + ' including a seamed, fitted install.';
        send.href = '/pages/contact?w=' + encodeURIComponent(hw.value) + '&l=' + encodeURIComponent(hl.value) + '&s=' + encodeURIComponent(sp.value);
      }
      [hw, hl, sp].forEach(function(el){ el.addEventListener('input', recalc); });
      recalc();
    }catch(e){ console.error('Calculator error', e); }
  })();

  (function(){
    try{
      var swatches = document.querySelectorAll('.mcc-swatch');
      var preview = document.getElementById('mccColorwayPreview');
      swatches.forEach(function(btn){
        btn.addEventListener('click', function(){
          swatches.forEach(function(b){ b.setAttribute('aria-pressed', 'false'); b.classList.remove('mcc-swatch-pulse'); });
          btn.setAttribute('aria-pressed', 'true');
          void btn.offsetWidth;
          btn.classList.add('mcc-swatch-pulse');
          if (preview) {
            preview.innerHTML = 'Selected: <strong>' + btn.dataset.name + '</strong> · <a href="/pages/contact?need=samples&colour=' + encodeURIComponent(btn.dataset.name) + '" style="border-bottom:1px solid var(--brass)">Ask about samples →</a>';
            preview.classList.add('is-visible');
          }
        });
      });
    }catch(e){ console.error('Colorway selector error', e); }
  })();
</script>
<script>
  (function(){
    try{
      var root = document.querySelector('[data-size-carousel]');
      if(!root) return;
      var cards = Array.prototype.slice.call(root.querySelectorAll('[data-carousel-card]'));
      if(cards.length < 2) return;
      var prevBtn = root.querySelector('[data-carousel-prev]'), nextBtn = root.querySelector('[data-carousel-next]');
      var status = root.querySelector('[data-carousel-status]');
      var blur = root.querySelector('#mccMotionBlur feGaussianBlur');
      var still = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      var n = cards.length, active = Math.floor((n - 1) / 2), raf = null, timer = null;

      function layout(){
        cards.forEach(function(card, i){
          var d = (i - active + n) % n;
          var pos = d === 0 ? 'active' : (d === 1 ? 'next' : (d === n - 1 ? 'prev' : 'hidden'));
          card.setAttribute('data-pos', pos);
          card.setAttribute('aria-label', (i + 1) + ' of ' + n);
          card.setAttribute('aria-hidden', pos === 'active' ? 'false' : 'true');
          card.querySelectorAll('a, button').forEach(function(el){
            if(pos === 'active'){ el.removeAttribute('tabindex'); } else { el.setAttribute('tabindex', '-1'); }
          });
        });
        var title = cards[active].querySelector('h3');
        if(status && title){ status.textContent = 'Showing ' + title.textContent.trim() + ', ' + (active + 1) + ' of ' + n; }
      }

      function pop(){
        var box = cards[active].querySelector('.mcc-buy-box');
        if(!box || still) return;
        box.classList.remove('is-popping'); void box.offsetWidth; box.classList.add('is-popping');
      }

      function motionBlur(dir){
        if(still || !blur) return;
        var start = null, dur = 450;
        root.classList.add('is-moving');
        cancelAnimationFrame(raf);
        function step(t){
          if(start === null) start = t;
          var k = Math.min(1, (t - start) / dur);
          var amount = 9 * Math.sin(Math.PI * k);
          blur.setAttribute('stdDeviation', amount.toFixed(2) + ' 0');
          if(k < 1){ raf = requestAnimationFrame(step); }
          else { blur.setAttribute('stdDeviation', '0 0'); root.classList.remove('is-moving'); }
        }
        raf = requestAnimationFrame(step);
      }

      function go(index){
        var next = (index + n) % n;
        if(next === active) return;
        cards.forEach(function(c){ var b = c.querySelector('.mcc-buy-box'); if(b){ b.classList.remove('is-popping'); } });
        active = next;
        motionBlur();
        layout();
        clearTimeout(timer);
        timer = setTimeout(pop, still ? 0 : 260);
      }

      prevBtn.addEventListener('click', function(){ go(active - 1); });
      nextBtn.addEventListener('click', function(){ go(active + 1); });

      root.addEventListener('click', function(e){
        var card = e.target.closest('[data-carousel-card]');
        if(card && card.getAttribute('data-pos') !== 'active'){
          e.preventDefault(); e.stopPropagation();
          go(cards.indexOf(card));
        }
      }, true);

      root.addEventListener('keydown', function(e){
        if(e.key === 'ArrowLeft'){ e.preventDefault(); go(active - 1); prevBtn.focus(); }
        if(e.key === 'ArrowRight'){ e.preventDefault(); go(active + 1); nextBtn.focus(); }
      });

      var x0 = null;
      root.addEventListener('touchstart', function(e){ x0 = e.touches[0].clientX; }, { passive: true });
      root.addEventListener('touchend', function(e){
        if(x0 === null) return;
        var dx = e.changedTouches[0].clientX - x0; x0 = null;
        if(Math.abs(dx) > 40){ go(active + (dx < 0 ? 1 : -1)); }
      }, { passive: true });

      prevBtn.hidden = false; nextBtn.hidden = false;
      root.classList.add('is-ready');
      layout();
      setTimeout(pop, 300);
    }catch(e){ console.error('Hall size carousel error', e); }
  })();
</script>

