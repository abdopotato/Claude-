{{ 'mosque-update.css' | asset_url | stylesheet_tag }}
<div id="mcc-app">
<section class="mcc-hero">
  <div class="mcc-hero-skyline" aria-hidden="true">
    <svg viewBox="0 0 1400 220" preserveAspectRatio="none" xmlns="http://www.w3.org/2000/svg">
      <path d="M0 220 V150 L40 150 L40 120 A20 20 0 0 1 80 120 L80 150 L110 150 L110 90 A55 55 0 0 1 220 90 L220 150 L260 150 L260 130 L280 100 L300 130 L300 150 L360 150 L360 60 A70 70 0 0 1 500 60 L500 150 L540 150 L540 125 L560 95 L580 125 L580 150 L660 150 L660 40 A85 85 0 0 1 830 40 L830 150 L870 150 L870 128 L890 98 L910 128 L910 150 L980 150 L980 75 A60 60 0 0 1 1100 75 L1100 150 L1140 150 L1140 132 L1160 100 L1180 132 L1180 150 L1400 150 V220 Z" fill="var(--green-900)"/>
      <circle cx="80" cy="112" r="6" fill="var(--brass)" opacity="0.4"/>
      <circle cx="430" cy="52" r="7" fill="var(--brass)" opacity="0.4"/>
      <circle cx="745" cy="32" r="8" fill="var(--brass)" opacity="0.4"/>
      <circle cx="1040" cy="67" r="6" fill="var(--brass)" opacity="0.4"/>
    </svg>
  </div>

  <div class="mcc-hero-inner">
    <div class="mcc-hero-copy">
      <div class="mcc-trust-badge"><span class="mcc-dot"></span>{{ section.settings.trust_text }}</div>
      <h1>{{ section.settings.heading }}</h1>
      <p>{{ section.settings.text }}</p>
      <div class="mcc-hero-actions">
        <a href="#sizes" class="mcc-btn-primary">Shop hall sizes</a>
        <a href="/pages/contact" class="mcc-btn-secondary">Request a quote</a>
      </div>
      <p class="mcc-cta-note" style="margin-top:12px;">{{ section.settings.cta_note }}</p>
    </div>

    <div class="mcc-hero-card" style="--r:0deg;">
      <svg viewBox="0 0 280 340" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
        <defs>
          <linearGradient id="archfill2" x1="0" y1="0" x2="0" y2="1"><stop offset="0%" stop-color="#204A40"/><stop offset="100%" stop-color="#0F2822"/></linearGradient>
          <pattern id="saffLines2" width="280" height="20" patternUnits="userSpaceOnUse"><line x1="0" y1="0" x2="280" y2="0" stroke="#B8892F" stroke-width="1" opacity="0.5"/></pattern>
        </defs>
        <rect x="0" y="0" width="280" height="340" rx="20" fill="url(#archfill2)"/>
        <rect x="0" y="0" width="280" height="340" rx="20" fill="url(#saffLines2)"/>
        <path d="M40 300 V160 C40 90 85 45 140 45 C195 45 240 90 240 160 V300" fill="none" stroke="#D7AE5C" stroke-width="1.4" opacity="0.6"/>
        <g transform="translate(56,268)">
          <rect x="0" y="0" width="168" height="42" rx="6" fill="#5C2A2A"/>
          <rect x="0" y="0" width="168" height="42" rx="6" fill="none" stroke="#B8892F" stroke-width="1.3"/>
          <ellipse cx="4" cy="21" rx="9" ry="21" fill="#7A3434"/>
          <ellipse cx="4" cy="21" rx="9" ry="21" fill="none" stroke="#D7AE5C" stroke-width="1.2"/>
          <ellipse cx="164" cy="21" rx="9" ry="21" fill="#4E2323"/>
        </g>
      </svg>
      <div class="mcc-hero-card-tag">95cm spacing<span class="mcc-ar">— جاهز للفرش</span></div>
    </div>
  </div>
</section>

<div class="mcc-strip mcc-trust-band">
  <div class="mcc-wrap">
    <div class="mcc-strip-item"><strong>Woven-in saff lines</strong>True 90 / 95 / 100cm spacing, woven in and never printed</div>
    <div class="mcc-strip-item"><strong>Professional installation</strong>Measured, seamed and fitted by our crew</div>
    <div class="mcc-strip-item"><strong>Fire rated</strong>{{ section.settings.fire_rating }}</div>
    <div class="mcc-strip-item"><strong>Committee invoicing</strong>{{ section.settings.payment_text }}</div>
  </div>
</div>

<section class="mcc-section mcc-tight-top" id="sizes">
  <div class="mcc-wrap">
    <div class="mcc-section-head" data-reveal>
      <h2>{{ section.settings.sizes_heading }}</h2>
      <p>{{ section.settings.sizes_text }}</p>
    </div>
    <div class="mcc-size-carousel" data-size-carousel data-reveal role="region" aria-roledescription="carousel" aria-label="Hall sizes">
    <button type="button" class="mcc-carousel-nav mcc-carousel-prev" data-carousel-prev aria-label="Previous hall size" hidden>&#8249;</button>
    <div class="mcc-grid-by-size" data-carousel-track>
      {%- for block in section.blocks -%}
        {%- if block.type != 'hall_size' -%}{%- continue -%}{%- endif -%}
        {%- assign p = block.settings.product -%}
        {%- if p != blank -%}{%- assign card_url = p.url -%}{%- else -%}{%- assign card_url = routes.all_products_collection_url -%}{%- endif -%}
        <article class="mcc-size-card{% if block.settings.popular %} mcc-pop{% endif %}" data-carousel-card aria-roledescription="slide" {{ block.shopify_attributes }}>
          {%- if block.settings.popular -%}<span class="mcc-pop-tag">Most ordered</span>{%- endif -%}
          <div class="mcc-card-media">
            {%- if p != blank and p.featured_media -%}
              {%- assign alt = p.featured_media.alt | default: p.title -%}
              {{ p.featured_media.preview_image | image_url: width: 900 | image_tag: loading: 'lazy', widths: '400, 600, 900', sizes: '(min-width: 900px) 360px, 100vw', alt: alt }}
            {%- else -%}
              {%- assign rows_n = forloop.index | times: 3 | plus: 4 -%}
              <svg viewBox="0 0 320 180" aria-hidden="true" preserveAspectRatio="xMidYMid slice">
                <rect width="320" height="180" fill="#0F2822"/>
                <g transform="translate(40,26)"><rect width="240" height="128" rx="4" fill="#16352E" stroke="#B8892F" stroke-opacity=".35"/>
                  <g stroke="#B8892F" stroke-opacity=".7">{%- for r in (1..rows_n) -%}{%- assign y = 128 | times: r | divided_by: rows_n | plus: 0 -%}{%- if y < 128 -%}<line x1="0" y1="{{ y }}" x2="240" y2="{{ y }}"/>{%- endif -%}{%- endfor -%}</g>
                </g>
              </svg>
            {%- endif -%}
          </div>
          <div class="mcc-size-head">
            <div class="mcc-dims">{{ block.settings.dims }}<span> {{ block.settings.unit }}</span></div>
            {%- if block.settings.arabic != blank -%}<div class="mcc-dims-ar">{{ block.settings.arabic }}</div>{%- endif -%}
          </div>
          <h3><a class="mcc-card-title-link" href="{{ card_url }}">{{ block.settings.title }}</a></h3>
          <p>{{ block.settings.description }}</p>
          {%- if block.settings.rows != blank -%}<div class="mcc-rows">{{ block.settings.rows }}</div>{%- endif -%}
          {%- if block.settings.include_1 != blank or block.settings.include_2 != blank -%}
            <ul class="mcc-incl">
              {%- if block.settings.include_1 != blank -%}<li>{{ block.settings.include_1 }}</li>{%- endif -%}
              {%- if block.settings.include_2 != blank -%}<li>{{ block.settings.include_2 }}</li>{%- endif -%}
            </ul>
          {%- endif -%}
          <div class="mcc-buy-box">
            <div class="mcc-buy-top">
              <span class="mcc-buy-label">Buy online</span>
              <span class="mcc-price">{% if p != blank %}from {{ p.price_min | money_without_trailing_zeros }} {{ cart.currency.iso_code }}{% else %}{{ block.settings.price_text }}{% endif %}</span>
            </div>
            {%- if p != blank and p.available -%}
              <a class="mcc-btn-primary mcc-buy-btn" href="{{ p.url }}" aria-label="Buy now: {{ block.settings.title | escape }}">Buy now</a>
              <p class="mcc-buy-note">Choose row spacing, colourway and installation on the next step.</p>
            {%- else -%}
              <a class="mcc-btn-primary mcc-buy-btn" href="/pages/contact{% if p != blank %}?product={{ p.handle | url_encode }}{% endif %}">Request a quote</a>
              <p class="mcc-buy-note">Online ordering for this size opens soon.</p>
            {%- endif -%}
            <a class="mcc-buy-quote" href="/pages/contact{% if p != blank %}?product={{ p.handle | url_encode }}{% endif %}">Prefer a quote first?</a>
          </div>
        </article>
      {%- endfor -%}
    </div>
    <button type="button" class="mcc-carousel-nav mcc-carousel-next" data-carousel-next aria-label="Next hall size" hidden>&#8250;</button>
    <p class="mcc-visually-hidden" aria-live="polite" data-carousel-status></p>
    </div>
    <div class="mcc-size-help" data-reveal>
      <div class="mcc-size-help-tip">
        <strong>Which row spacing?</strong>
        <span><b>90cm</b> tighter halls</span><span><b>95cm</b> recommended for most mosques</span><span><b>100cm</b> Jumu'ah &amp; Eid halls</span>
      </div>
      <a class="mcc-btn-ghost" href="/pages/contact">Not sure of your size? Send us your measurements</a>
    </div>
  </div>
</section>

<section class="mcc-section mcc-band" id="colours">
  <div class="mcc-wrap">
    <div class="mcc-section-head" data-reveal>
      <h2>Colourways</h2>
      <p>Each colourway is dyed and woven as one production run at the mill, so pile depth and line contrast match across your whole order. Tap a shade to ask about samples.</p>
    </div>
    <div class="mcc-colorways">
      <button type="button" class="mcc-swatch" data-name="Masjid Green" aria-pressed="false"><div class="mcc-block" style="background:#0F2822"></div><p>Masjid Green</p><div class="mcc-ar-name">أخضر</div><span>Our most-ordered shade</span></button>
      <button type="button" class="mcc-swatch" data-name="Maroon" aria-pressed="false"><div class="mcc-block" style="background:#5C2A2A"></div><p>Maroon</p><div class="mcc-ar-name">عنابي</div><span>Traditional, low-glare</span></button>
      <button type="button" class="mcc-swatch" data-name="Deep Indigo" aria-pressed="false"><div class="mcc-block" style="background:#1B2A4A"></div><p>Deep Indigo</p><div class="mcc-ar-name">نيلي</div><span>Evening-lit halls</span></button>
      <button type="button" class="mcc-swatch" data-name="Walnut Brown" aria-pressed="false"><div class="mcc-block" style="background:#3B2A17"></div><p>Walnut Brown</p><div class="mcc-ar-name">بني</div><span>Hides daily foot traffic</span></button>
      <button type="button" class="mcc-swatch" data-name="Camel Gold" aria-pressed="false"><div class="mcc-block" style="background:#8A6A2E"></div><p>Camel Gold</p><div class="mcc-ar-name">ذهبي</div><span>Bright, south-facing halls</span></button>
    </div>
    <p class="mcc-colorway-preview" id="mccColorwayPreview" aria-live="polite"></p>
  </div>
</section>

<section class="mcc-section" id="faq">
  <div class="mcc-wrap">
    <div class="mcc-section-head" data-reveal><h2>Questions committees ask us</h2></div>
    <div class="mcc-faq">
      {%- for block in section.blocks -%}
        {%- if block.type != 'faq' -%}{%- continue -%}{%- endif -%}
        <details {% if forloop.first %}open{% endif %} {{ block.shopify_attributes }}><summary>{{ block.settings.question }}</summary><p>{{ block.settings.answer }}</p></details>
      {%- endfor -%}
    </div>
  </div>
</section>

<section class="mcc-cta mcc-on-dark" data-reveal>
  <div><h2>{{ section.settings.cta_heading }}</h2><p>{{ section.settings.cta_text }}</p></div>
  <div class="mcc-cta-actions"><a href="/pages/contact" class="mcc-btn-primary">Request a quote</a><a href="/pages/contact?need=samples" class="mcc-btn-ghost">Ask about samples</a><p class="mcc-cta-note">{{ section.settings.cta_note }}</p></div>
</section>
</div>
<script>
  (function(){
    try{
      var swatches = document.querySelectorAll('.mcc-swatch');
      var preview = document.getElementById('mccColorwayPreview');
      swatches.forEach(function(btn){
        btn.addEventListener('click', function(){
          swatches.forEach(function(b){ b.setAttribute('aria-pressed', 'false'); b.classList.remove('mcc-swatch-pulse'); });
          btn.setAttribute('aria-pressed', 'true');
          void btn.offsetWidth;
          btn.classList.add('mcc-swatch-pulse');
          if (preview) {
            preview.innerHTML = 'Selected: <strong>' + btn.dataset.name + '</strong> · <a href="/pages/contact?need=samples&colour=' + encodeURIComponent(btn.dataset.name) + '" style="border-bottom:1px solid var(--brass)">Ask about samples →</a>';
            preview.classList.add('is-visible');
          }
        });
      });
    }catch(e){ console.error('Colorway selector error', e); }
  })();
</script>
<script>
  (function(){
    try{
      var root = document.querySelector('[data-size-carousel]');
      if(!root) return;
      var cards = Array.prototype.slice.call(root.querySelectorAll('[data-carousel-card]'));
      if(cards.length < 2) return;
      var prevBtn = root.querySelector('[data-carousel-prev]'), nextBtn = root.querySelector('[data-carousel-next]');
      var status = root.querySelector('[data-carousel-status]');
      var still = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      var n = cards.length, active = Math.floor((n - 1) / 2), timer = null;

      function layout(){
        cards.forEach(function(card, i){
          var d = (i - active + n) % n;
          var pos = d === 0 ? 'active' : (d === 1 ? 'next' : (d === n - 1 ? 'prev' : 'hidden'));
          card.setAttribute('data-pos', pos);
          card.setAttribute('aria-label', (i + 1) + ' of ' + n);
          card.setAttribute('aria-hidden', pos === 'active' ? 'false' : 'true');
          card.querySelectorAll('a, button').forEach(function(el){
            if(pos === 'active'){ el.removeAttribute('tabindex'); } else { el.setAttribute('tabindex', '-1'); }
          });
        });
        var title = cards[active].querySelector('h3');
        if(status && title){ status.textContent = 'Showing ' + title.textContent.trim() + ', ' + (active + 1) + ' of ' + n; }
      }

      function pop(){
        var box = cards[active].querySelector('.mcc-buy-box');
        if(!box || still) return;
        box.classList.remove('is-popping'); void box.offsetWidth; box.classList.add('is-popping');
      }

      function go(index){
        var next = (index + n) % n;
        if(next === active) return;
        cards.forEach(function(c){ var b = c.querySelector('.mcc-buy-box'); if(b){ b.classList.remove('is-popping'); } });
        active = next;
        layout();
        clearTimeout(timer);
        timer = setTimeout(pop, still ? 0 : 260);
      }

      prevBtn.addEventListener('click', function(){ go(active - 1); });
      nextBtn.addEventListener('click', function(){ go(active + 1); });

      root.addEventListener('click', function(e){
        var card = e.target.closest('[data-carousel-card]');
        if(card && card.getAttribute('data-pos') !== 'active'){
          e.preventDefault(); e.stopPropagation();
          go(cards.indexOf(card));
        }
      }, true);

      root.addEventListener('keydown', function(e){
        if(e.key === 'ArrowLeft'){ e.preventDefault(); go(active - 1); prevBtn.focus(); }
        if(e.key === 'ArrowRight'){ e.preventDefault(); go(active + 1); nextBtn.focus(); }
      });

      var x0 = null;
      root.addEventListener('touchstart', function(e){ x0 = e.touches[0].clientX; }, { passive: true });
      root.addEventListener('touchend', function(e){
        if(x0 === null) return;
        var dx = e.changedTouches[0].clientX - x0; x0 = null;
        if(Math.abs(dx) > 40){ go(active + (dx < 0 ? 1 : -1)); }
      }, { passive: true });

      prevBtn.hidden = false; nextBtn.hidden = false;
      root.classList.add('is-ready');
      layout();
      setTimeout(pop, 300);
    }catch(e){ console.error('Hall size carousel error', e); }
  })();
</script>

{% schema %}
{
  "name": "Mosque carpet home",
  "settings": [
    { "type": "header", "content": "Hero" },
    { "type": "text", "id": "trust_text", "label": "Badge above heading", "default": "Imported luxury prayer carpet, supplied & installed for Canadian mosques" },
    { "type": "text", "id": "kicker", "label": "Kicker (not shown in this layout)", "default": "Chosen for the saff, not the showroom" },
    { "type": "text", "id": "heading", "label": "Hero heading", "default": "Luxury prayer-hall carpet, fitted by our own team" },
    { "type": "textarea", "id": "text", "label": "Hero text", "default": "Wall-to-wall rolls from specialist mills, with prayer lines woven in at 90, 95 or 100cm. We import, measure and install: one team from quote to first salah." },
    { "type": "text", "id": "stat_1_value", "label": "Stat 1 value (not shown in this layout)", "default": "3" },
    { "type": "text", "id": "stat_1_label", "label": "Stat 1 label", "default": "row spacings" },
    { "type": "text", "id": "stat_2_value", "label": "Stat 2 value (not shown in this layout)", "default": "1.5–6m" },
    { "type": "text", "id": "stat_2_label", "label": "Stat 2 label", "default": "roll widths" },
    { "type": "text", "id": "stat_3_value", "label": "Stat 3 value (not shown in this layout)", "default": "Supply + fit" },
    { "type": "text", "id": "stat_3_label", "label": "Stat 3 label", "default": "one team, one invoice" },
    { "type": "text", "id": "cta_note", "label": "Note under quote buttons", "default": "Free and itemised, with no obligation." },
    { "type": "header", "content": "Trust strip" },
    { "type": "text", "id": "fire_rating", "label": "Fire rating text", "default": "CAN/ULC-S102 & ASTM E648 certified pile" },
    { "type": "text", "id": "payment_text", "label": "Payment text", "default": "PO and bank transfer accepted" },
    { "type": "header", "content": "Hall sizes" },
    { "type": "text", "id": "sizes_heading", "label": "Hall size heading", "default": "Shop by hall size" },
    { "type": "textarea", "id": "sizes_text", "label": "Hall size text", "default": "Buy online in three standard sizes, or request a quote for any hall. Either way, we confirm exact measurements before anything is cut." },
    { "type": "header", "content": "Sourcing" },
    { "type": "image_picker", "id": "sourcing_image", "label": "Photo (replaces the illustration) (not shown on the homepage right now)" },
    { "type": "text", "id": "sourcing_kicker", "label": "Kicker (not shown on the homepage right now)", "default": "Sourced, not manufactured, and that's the point" },
    { "type": "text", "id": "sourcing_heading", "label": "Heading (not shown on the homepage right now)", "default": "We source it. We check it. We bring it home." },
    { "type": "textarea", "id": "sourcing_text", "label": "Text (not shown on the homepage right now)", "default": "We don't own a loom, so we're never tied to one factory's range. We work with specialist prayer-carpet mills overseas and choose each roll for pile density, colourfastness and how straight its lines run. Then we import it, inspect it in Canada and deliver it to your door." },
    { "type": "header", "content": "Process & installation" },
    { "type": "text", "id": "lead_time_text", "label": "Step 3 badge (lead time) (not shown on the homepage right now)", "default": "Lead time in your quote" },
    { "type": "text", "id": "service_area", "label": "Service area (not shown on the homepage right now)", "default": "Across Canada, with travel itemised" },
    { "type": "header", "content": "Testimonial (hidden until filled in)" },
    { "type": "textarea", "id": "testimonial_quote", "label": "Quote (not shown on the homepage right now)" },
    { "type": "text", "id": "testimonial_author", "label": "Attribution (not shown on the homepage right now)" },
    { "type": "header", "content": "Closing call-to-action" },
    { "type": "text", "id": "cta_heading", "label": "Heading", "default": "Ready to re-carpet your musalla?" },
    { "type": "textarea", "id": "cta_text", "label": "Text", "default": "Send your hall dimensions or a floor plan. We'll reply with a spacing recommendation, a roll layout and an itemised quote covering supply, import and installation." }
  ],
  "blocks": [
    {
      "type": "hall_size",
      "name": "Hall size card",
      "settings": [
        { "type": "text", "id": "dims", "label": "Dimensions", "default": "4 × 6" },
        { "type": "text", "id": "unit", "label": "Unit label", "default": "m room" },
        { "type": "text", "id": "arabic", "label": "Arabic label" },
        { "type": "text", "id": "title", "label": "Title", "default": "Musalla, small" },
        { "type": "textarea", "id": "description", "label": "Description" },
        { "type": "text", "id": "include_1", "label": "Included line 1" },
        { "type": "text", "id": "include_2", "label": "Included line 2" },
        { "type": "checkbox", "id": "popular", "label": "Show \"Most ordered\" tag", "default": false },
        { "type": "text", "id": "rows", "label": "Rows line", "default": "≈ 5 prayer rows at 95cm spacing" },
        { "type": "text", "id": "price_text", "label": "Price text (used until a product is linked)", "default": "from $1,150 CAD" },
        { "type": "product", "id": "product", "label": "Linked product" }
      ]
